rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow users to read their own profile, admins can read all
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Allow owner to create profile if admin and premium are initialised to false
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.isAdmin == false &&
        request.resource.data.isPremium == false;
        
      // WARNING: When adding new fields to the user document, ensure they are NOT added
      // to the allowlist below unless they are explicitly safe for the user to modify directly.
      // Sensitive billing, entitlement, and authorization fields (e.g. isAdmin, isPremium,
      // stripeCustomerId, stripeSubscriptionId, premiumSubscriptionStatus, trialEndsAt)
      // must NEVER be added to this allowlist.
      //
      // Allow owner to update only allowlisted fields, admins can update all
      allow update: if request.auth != null && (
        isAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'myWhy', 'currentWeight', 'targetWeight', 'activityLevel', 
            'startingWeight', 'journeyStartDate', 'targetWaterIntake', 'targetCalories', 
            'targetProtein', 'targetCarbs', 'targetFat', 'estimatedGoalDate', 'updatedAt', 
            'currentStreak', 'lastLogDate', 'activeWorkoutPlan'
          ])
        )
      );
      
      allow delete: if false;

      // Rules for the 'foodLogs' subcollection
      match /foodLogs/{logId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Rules for the 'weightLogs' subcollection
      match /weightLogs/{logId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Rules for the 'workoutLogs' subcollection
      match /workoutLogs/{logId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Rules for the 'waterLogs' subcollection
      match /waterLogs/{logId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Rules for the 'quotas' subcollection
      match /quotas/{month} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Rules for the 'feedbackSubmissions' collection
    match /feedbackSubmissions/{feedbackId} {
      // Allow create if authenticated and the feedback matches the owner's UID
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Users can only read their own feedback submissions. Admins can read all.
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Disallow client-side updates and deletes for feedback submissions.
      allow update, delete: if false;
    }
  }
}
